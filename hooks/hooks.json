{
  "description": "Shows who is waiting on you at session start and keeps one shared refresher running while any session is open.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
